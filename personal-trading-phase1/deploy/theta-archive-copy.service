[Unit]
Description=Theta archive read-only persistent copy
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/srv/personal-trading
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=10001
Group=10001
UMask=0077
ExecStart=/usr/bin/python3 -u /opt/theta-archive-worker/archive_vm.py run
TimeoutStartSec=infinity
Restart=on-failure
RestartSec=60
RemainAfterExit=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/personal-trading/archive-worker

[Install]
WantedBy=multi-user.target
