API_PORT=8000
# Conservative account-wide spacing; this limiter covers this installation only.
DHAN_MIN_SPACING_MS=1100
DHAN_DAILY_GUARD=90000
MAX_FETCH_ATTEMPTS=4
BACKOFF_BASE_SECONDS=5
BACKOFF_CAP_SECONDS=300
# Bootstrap tags. Pin audited image digests before production deployment.
TIMESCALE_IMAGE=timescale/timescaledb:latest-pg17
REDIS_IMAGE=redis:7.4-alpine
